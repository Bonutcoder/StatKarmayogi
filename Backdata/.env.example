# APP CONFIG
APP_ENV=development
APP_BASE_URL=http://localhost:8000
SECRET_KEY=statkarmayogi-super-secret-key-change-in-production-32-bytes

# DATABASE
# For SQLite local dev: sqlite+aiosqlite:///./statkarmayogi.db
# For PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/statkarmayogi
DATABASE_URL=sqlite+aiosqlite:///./statkarmayogi.db

# SUPABASE AUTH
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# OAUTH PROVIDERS (SUPABASE AUTH)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# STORAGE
STORAGE_LOCAL_ROOT=./private_storage
MAX_UPLOAD_SIZE_MB=25

# AI GATEWAY (OPENROUTER)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001
